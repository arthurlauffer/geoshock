# Provider LLM (anthropic | openai | google)
LLM_PROVIDER=anthropic

# API Keys — preencher pelo menos uma
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# FRED API Key (gratuita em fred.stlouisfed.org)
FRED_API_KEY=...

# Embedding provider (local | openai) — default: local
EMBEDDING_PROVIDER=local

# Cache settings
CACHE_TTL_SECONDS=3600
GDELT_RATE_LIMIT_RPS=1
